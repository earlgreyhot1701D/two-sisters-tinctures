# Copy to .env for local runs. Never commit .env. On Render, set these in the dashboard.
GEMINI_API_KEY=
MODEL_PROVIDER=gemini
# Optional. Defaults shown.
# Production (render.yaml) uses DAILY_CAP=200.
DAILY_CAP=50
IP_DAILY_CAP=10
MODEL_TIMEOUT_MS=30000

# Optional: MINIMAL (default), LOW, MEDIUM, HIGH, or off
MODEL_THINKING_LEVEL=MINIMAL
